// Drag a tab along its bar to put it somewhere else in the group.
id tab-reorder
title "Reorder tabs by dragging"
view {width 1600, height 900}
capture {fps 20, crop @tabs"note-welcome", pad 40, width 960}
steps (
    {
        id vault
        do @run{id LAB_GO_VAULT}
        done {on (@changed"lab"), check ({id LAB_STATE, has {tab vault}})}
        hide true
    }
    {
        id room
        do @run{id LAB_TOGGLE_DETAILS}
        hide true
    }
    {
        id drag
        text "Drag a tab along the bar: the others make room, and it lands where you let go."
        target @tab"note-welcome"
        // A fixed distance, past the last tab's middle: the Arrangement tab
        // slides aside as the drag passes it, so an end found on it each
        // frame pulls the pointer back short of it.
        do @drag{dx 420, seconds 1.0}
        done {
            on (@changed"workspace")
            check ({id WORKSPACE_LAYOUT, has {windows ({groups ({tabs (note-shell arrange note-welcome)} {tabs (graph)})})}})
        }
        hold 1.0
    }
)
