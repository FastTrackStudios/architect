// Stacked tabs: a group's tabs side by side in a strip that slides, each
// with its name down its spine.
id stacked-tabs
title "Stacked tabs"
view {width 1600, height 900}
capture {fps 20, crop @group"note-welcome", pad 8, width 960}
steps (
    {
        id vault
        do @run{id LAB_GO_VAULT}
        done {on (@changed"lab"), check ({id LAB_STATE, has {tab vault}})}
        hide true
    }
    {
        id room
        do @run{id LAB_TOGGLE_DETAILS}
        hide true
    }
    {
        id pick
        target @tab"note-welcome"
        do @click{}
        done {check ({id WORKSPACE_LAYOUT, has {active note-welcome}})}
        hide true
    }
    {
        id stack
        text "Stack the group's tabs: Panes › Stack tabs."
        do @run{id WORKSPACE_STACK_TABS}
        done {
            on (@changed"workspace")
            check ({id WORKSPACE_LAYOUT, has {windows ({groups ({stacked true} {stacked false})})}})
        }
        hold 0.8
    }
    {
        id slide
        text "Scroll sideways: the strip slides, each pane's spine stays in view."
        target @group"note-welcome"
        do @scroll{dx 520, seconds 1.2}
        hold 1.0
    }
)
