filters:
  and:
    - 'status != null'
views:
  - type: table
    name: By status
    order:
      - file.name
      - status
      - tags
    groupBy:
      property: status
      direction: ASC
  - type: cards
    name: Cards
    order:
      - file.name
      - status
      - tags
  - type: list
    name: List
    order:
      - file.name
      - status
