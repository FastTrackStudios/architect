// ⌘K: open the palette, find a command by typing a few of its letters,
// run it. Filmed into palette-run.gif; played as a test by
// apps/sandbox/media/tests/scenarios.rs.
id palette-run
title "Run any command from ⌘K"
view {width 1280, height 800}
capture {fps 20, width 960}
steps (
    {
        id open
        text "⌘K opens the palette: every command the app has, a view's own too."
        do @run{id LAB_SHOW_COMMANDS}
        done {
            on (@changed"commands")
            check ({id COMMANDS_STATE, has {overlay palette}})
        }
        hold 0.6
    }
    {
        id find
        text "Type a few letters of what you want."
        do @type{text "sched"}
        done {check ({id COMMANDS_STATE, has {query sched}})}
        hold 0.4
    }
    {
        id run
        text "Pick it: the palette closes and the command runs."
        target @palette-row"LAB_GO_SCHEDULE"
        do @click{}
        done {
            on (@changed"lab")
            check ({id LAB_STATE, has {tab schedule}} {id COMMANDS_STATE, has {overlay ""}})
        }
        hold 1.0
    }
)
