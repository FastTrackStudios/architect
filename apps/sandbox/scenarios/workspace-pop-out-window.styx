// A tab dragged out of the main window opens as a window of its own;
// dragged back by its tab, it is a tab in the main window again.
id workspace-pop-out-window
title "Pop a tab out into its own window"
view {width 1360, height 800, x 40, y 68}
capture {fps 20, width 1280, desktop {width 1920, height 968}}
steps (
    {
        id vault
        do @run{id LAB_GO_VAULT}
        done {on (@changed"lab"), check ({id LAB_STATE, has {tab vault}})}
        hide true
    }
    // The Clicker pane is a process extension's view: headless its
    // program is not running, so it goes before the take.
    {
        id pick-clicker
        target @tab"clicker"
        do @click{}
        done {check ({id WORKSPACE_LAYOUT, has {active clicker}})}
        hide true
    }
    {
        id close-clicker
        do @run{id WORKSPACE_CLOSE_TAB}
        done {
            on (@changed"workspace")
            check ({id WORKSPACE_LAYOUT, has {windows ({docked ({tabs (files search)} {tabs (outline backlinks)})})}})
        }
        hide true
    }
    // The arrangement's script floats a tool window whenever it shows;
    // out of the way here.
    {
        id pick-arrange
        target @tab"arrange"
        do @click{}
        hide true
    }
    {
        id close-arrange
        target @css"[aria-label=\"Close Arrangement\"]"
        do @click{}
        done {
            on (@changed"workspace")
            check ({id WORKSPACE_LAYOUT, has {windows ({groups ({tabs (note-welcome note-shell)} {tabs (graph)})})}})
        }
        hide true
    }
    {
        id close-tool-window
        target @css"[aria-label=\"Close Marker lane\"]"
        do @click{}
        done {on (@changed"workspace")}
        hide true
    }
    {
        id welcome
        target @tab"note-welcome"
        do @click{}
        done {check ({id WORKSPACE_LAYOUT, has {active note-welcome}})}
        hide true
    }
    {
        id out
        text "Drag a tab out of the window: it opens as a window of its own."
        target @tab"note-shell"
        do @drag{to @at{x 1600, y 300}, seconds 1.4}
        done {
            on (@changed"workspace")
            check ({id WORKSPACE_LAYOUT, has {windows ({id main} {groups ({tabs (note-shell)})})}})
        }
        hold 1.2
    }
    {
        id back
        text "Drag it back onto the main window: a tab there again, its window gone."
        target @tab"note-shell"
        do @drag{to @group"note-welcome", seconds 1.4}
        done {
            on (@changed"workspace")
            check ({id WORKSPACE_LAYOUT, has {windows ({groups ({tabs (note-welcome note-shell)} {tabs (graph)})})}})
        }
        hold 1.2
    }
)
