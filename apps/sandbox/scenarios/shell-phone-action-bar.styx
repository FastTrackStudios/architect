// A phone's action bar: the app's buttons over the tabs, and on the
// Vault the workspace's tabs button, its open panes counted, in place of
// the app's last.
id shell-phone-action-bar
title "The action bar on a phone"
view {width 402, height 874}
capture {fps 20, width 402, outputs (png)}
steps (
    {
        id vault
        do @run{id LAB_GO_VAULT}
        done {on (@changed"lab"), check ({id LAB_STATE, has {tab vault, bar actions}})}
        hide true
    }
    {
        id tabs
        text "The tabs button counts the open panes; a press shows them all."
        target @css"[data-bar-item=\"WORKSPACE_EVERY_PANE\"]"
        do @click{}
        hold 0.6
    }
)
