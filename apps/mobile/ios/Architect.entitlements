<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The entitlements the app asks for. deploy-testflight.sh signs with
	     these and the profile's identity (its app id, team, keychain
	     groups), never the profile's whole set: each key here only when the
	     profile allows it, and nothing the profile has that is not here
	     (apps/mobile/ios/sign-entitlements.py). -->

	<!-- Universal links (#629, #186): share links and deep links into
	     actions on FasTrack's own node open in the app, when the profile
	     allows Associated Domains. The node's
	     /.well-known/apple-app-site-association (ARCHITECT_APPLE_APP_IDS)
	     names this app back. A node on another domain is reached through
	     architect://open?url=… instead. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:architect.fasttrackstudio.app</string>
	</array>

	<!-- HealthKit (#709) for the app's own compiled-in extensions (the
	     Health bundle, #371): reading and writing the types they name.
	     No clinical health records (an empty access list, though the
	     profile offers `health-records`) and no background delivery. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
