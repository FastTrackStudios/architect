{
  "name": "@fasttrackstudio/architect-cli",
  "version": "0.0.0-dev",
  "description": "Tooling for Architect extensions: make a WASI component ready for @fasttrackstudio/architect (`architect-ext build-web`: jco, metadata, a lock, typed actions, a size report), and scaffold, type-check, pack and sign a TypeScript extension (`new --typescript`, `types`, `check`, `pack`).",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FastTrackStudios/architect.git",
    "directory": "features/extensions/web/cli"
  },
  "homepage": "https://architect.fasttrackstudio.app/docs/guide/extensions-in-your-web-app/",
  "bugs": "https://github.com/FastTrackStudios/architect/issues",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "architect-ext": "./cli.mjs"
  },
  "exports": {
    ".": "./cli.mjs",
    "./typegen": "./typegen.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "cli.mjs",
    "typegen.mjs",
    "transpile.mjs",
    "manifest.mjs",
    "ts.mjs",
    "architect.d.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "prepack": "node ../scripts/build.mjs --cli"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@bytecodealliance/jco": "1.41.0",
    "smol-toml": "1.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
