// The `architect:extension` world: what a WASI component extension imports
// from its host and exports to it (features/extensions/src/wasi.rs, the
// host; features/extensions/wasi-guest, the Rust guest;
// docs/content/architecture/extensions.md, "WASI components").
//
// Hand-written, beside two sources it must match, checked by
// features/extensions/tests/wasi_wit.rs:
// - the `types` interface mirrors the remote-view wire
//   (features/extensions/src/wire.rs: `Edit`, `Value`, `ViewEvent`,
//   `EventData`, `Pointer`, `KeyData`, `Mods`, `ThemeData`, `Token`), case
//   for case and field for field, so a component's view is applied by the
//   same `RemoteDocument` a process's is;
// - the `host` interface is the host service (features/extensions/src/hostcall.rs
//   `HostRequest`): typed functions for the common calls, `call` for every
//   one, the same JSON a process, a Luau script and a linked extension send.
//   Each is checked against what the extension may reach, as a person
//   granted it, when it is made.
package architect:extension@0.1.0;

interface types {
    /// An attribute's value (`wire::Value`).
    variant value {
        none,
        text(string),
        float(f64),
        int(s64),
        %bool(bool),
    }

    record create-element {
        tag: string,
        namespace: option<string>,
    }

    record set-attribute {
        name: string,
        namespace: option<string>,
        value: value,
    }

    /// One of Dioxus's `WriteMutations`, as data (`wire::Edit`): a stack
    /// machine over the host's nodes. Ids are Dioxus's element ids; a count
    /// is how many nodes on the stack, the top the last one pushed.
    variant edit {
        push-id(u64),
        set-id(u64),
        child(u32),
        pop,
        create-element(create-element),
        create-text(string),
        clone,
        append-children(u32),
        replace-with(u32),
        insert-after(u32),
        insert-before(u32),
        set-attribute(set-attribute),
        set-text(string),
        listen(string),
        unlisten(string),
        remove,
    }

    /// The modifier keys held (`wire::Mods`).
    record mods {
        alt: bool,
        ctrl: bool,
        meta: bool,
        shift: bool,
    }

    /// Where a pointer was, in CSS pixels, and its buttons (`wire::Pointer`).
    record pointer {
        client-x: f64,
        client-y: f64,
        page-x: f64,
        page-y: f64,
        screen-x: f64,
        screen-y: f64,
        element-x: f64,
        element-y: f64,
        button: s16,
        buttons: u16,
        mods: mods,
    }

    /// A key, as the web names it (`wire::KeyData`).
    record key-data {
        key: string,
        code: string,
        location: u8,
        repeat: bool,
        composing: bool,
        mods: mods,
    }

    /// What an event carries (`wire::EventData`).
    variant event-data {
        mouse(pointer),
        key(key-data),
        form(string),
        focus,
    }

    /// An event on one of a view's elements (`wire::ViewEvent`).
    record view-event {
        element: u64,
        name: string,
        bubbles: bool,
        data: event-data,
    }

    /// One resolved theme token (`wire::Token`).
    record token {
        name: string,
        value: string,
    }

    /// The app's theme, as data (`wire::ThemeData`).
    record theme-data {
        id: string,
        scheme: string,
        revision: u64,
        tokens: list<token>,
    }

    /// The edits one open view made since it last sent any.
    record pane-edits {
        pane: u64,
        edits: list<edit>,
    }
}

/// The host service (`hostcall::HostRequest`): every call checked against
/// the extension's capabilities and a person's grants. An error is
/// `hostcall::HostError` as JSON (`{"kind": "refused", "capability": …,
/// "why": …}`).
interface host {
    use types.{theme-data};

    enum level {
        debug,
        info,
        warn,
        error,
    }

    /// Runs app action `action` with JSON `args`, as this extension acting
    /// for whoever ran it (`run`): its answer as JSON.
    run-action: func(action: string, args: string) -> result<string, string>;
    /// One of its own settings' values, as JSON (`setting`).
    setting: func(key: string) -> result<string, string>;
    /// Sets one of its own settings to JSON `value` (`set-setting`).
    set-setting: func(key: string, value: string) -> result<_, string>;
    /// The app's theme now.
    theme: func() -> theme-data;
    /// A line in its log (`EXT_LOGS`).
    log: func(level: level, text: string);
    /// Any host-service call (`hostcall::HostRequest` as JSON); its answer
    /// as JSON (`hostcall::HostAnswer`: `{"ok": …}` or `{"error": …}`).
    call: func(request: string) -> string;
    /// Calls method `method` of service `service` (one its manifest
    /// `[requires]`) with JSON `args` (`service`): the provider's answer,
    /// as JSON. The provider's action `<PREFIX><METHOD>` answers it, run as
    /// this extension within its capabilities.
    call-service: func(service: string, method: string, args: string) -> result<string, string>;

    // The app's interface (`capabilities.ui`). `pick`, `prompt` and
    // `menu` wait for the person; their answer is JSON, `null` for a
    // cancel.

    /// A notification (`notify`): `kind` is `info`, `success`, `warning`
    /// or `error`.
    notify: func(text: string, kind: string) -> result<_, string>;
    /// The clipboard's text (`clipboard-read`); none when it holds none.
    clipboard-read: func() -> result<option<string>, string>;
    /// Puts `text` on the clipboard (`clipboard-write`).
    clipboard-write: func(text: string) -> result<_, string>;
    /// A file or folder picker, or a save dialog (`pick`: `hostcall::Pick`
    /// as JSON): the path, or paths, picked.
    pick: func(request: string) -> result<string, string>;
    /// A question (`prompt`: `hostcall::Prompt` as JSON): the answer.
    prompt: func(request: string) -> result<string, string>;
    /// A context menu at a point (`menu`: `hostcall::Menu` as JSON): the
    /// id of the item chosen.
    menu: func(request: string) -> result<string, string>;
    /// An icon or badge on target `kind` `id` (`decorate`: `file` and its
    /// path, `tab` and its id), `hostcall::Decoration` as JSON; none takes
    /// it off.
    decorate: func(kind: string, id: string, decoration: option<string>) -> result<_, string>;

    // Time and events (features/extensions/src/host_events.rs).

    /// The time on the host's clock, ms since the epoch: what its views'
    /// timers run on (a test's clock is one it moves by hand).
    now: func() -> u64;
    /// A hook made at run time (`subscribe`: `contrib::HookDecl` as JSON,
    /// `{"on": "doc.saved", "action": …}` or `{"every": "5m", …}`): its
    /// key.
    subscribe: func(hook: string) -> result<string, string>;
    /// Takes the hook it made with key `key` off (`unsubscribe`): whether
    /// it had it.
    unsubscribe: func(key: string) -> result<bool, string>;
}

/// What a component does for its host.
interface guest {
    use types.{edit, view-event, pane-edits};

    /// Starts it, with the state the copy it replaces saved.
    init: func(state: option<list<u8>>) -> result<_, string>;
    /// The actions it runs, by id: each its manifest declares.
    actions: func() -> list<string>;
    /// The views it renders, by id.
    views: func() -> list<string>;
    /// Runs action `action` with JSON `args`, invoked from `invocation`
    /// (JSON: the palette, a menu and its target, a hook and its event).
    invoke: func(action: string, args: string, invocation: string) -> result<string, string>;
    /// Mounts view `view` as `pane`: its first render.
    render: func(pane: u64, view: string) -> result<list<edit>, string>;
    /// An event in `pane`'s view, for its handlers: what they changed.
    on-event: func(pane: u64, event: view-event) -> result<list<edit>, string>;
    /// What its open views changed by themselves (after an action ran).
    pending: func() -> list<pane-edits>;
    /// Unmounts `pane`'s view.
    close: func(pane: u64);
    /// Its state, for the copy that replaces it on a reload.
    save-state: func() -> option<list<u8>>;
    /// Runs its timers that are due on the host's clock (`now`): what
    /// they change in its views the host asks for next (`pending`). How
    /// many ms until the next is due; none when it has none.
    tick: func() -> option<u32>;
}

/// A component's workers (features/extensions/src/wasi/workers.rs): its
/// heavy work in more instances of it, each on a thread of the host's pool
/// with limits of its own, spoken to by JSON messages only. The same API
/// a Luau script's workers (features/scripting/src/worker.rs) and a
/// process's work (features/extensions/src/work.rs) have: `post`,
/// `progress`, `cancelled`, and the owner's news as `on-message`,
/// `on-progress` and `on-done` (the `work` interface).
///
/// An instance is an owner or a worker; what the other side's functions
/// do in it is said by each.
interface worker {
    /// How far a worker said it is (the latest wins).
    record progress-report {
        done: f64,
        total: f64,
        note: string,
    }

    /// An owner: starts its worker `name` (one of its manifest's
    /// `[[workers]]`) with JSON `args`, at once, in an instance of its own:
    /// its handle. Err when it has no such worker, or as many running as it
    /// may (back-pressure). In a worker: refused.
    spawn: func(name: string, args: string) -> result<u64, string>;
    /// A JSON message. An owner's, to its worker `to`: Err when that
    /// worker's queue is full (it has not read them; back-pressure) or it
    /// ended. A worker's, to its owner (`to` is 0): it waits while its
    /// owner's queue is full; Err once it is cancelled.
    post: func(to: u64, message: string) -> result<_, string>;
    /// An owner: stops its worker `worker` (at its next tick, whether it
    /// looks or not). In a worker: nothing.
    cancel: func(worker: u64);
    /// A worker: how far it is, `done` of `total`, with a note. In an
    /// owner: nothing.
    progress: func(done: f64, total: f64, note: string);
    /// A worker: whether its owner cancelled it or went. In an owner:
    /// false.
    cancelled: func() -> bool;
    /// A worker: the next message from its owner, waiting at most
    /// `wait-ms` (0: not at all); none for none. In an owner: none.
    receive: func(wait-ms: u32) -> option<string>;
}

/// What a component does as a worker, and as a worker's owner.
interface work {
    use worker.{progress-report};

    /// How a worker ended.
    variant outcome {
        /// What it returned (JSON).
        done(string),
        /// Why it failed: its error, or a limit it ran past.
        failed(string),
        /// Its owner cancelled it, or went.
        cancelled,
    }

    /// A worker instance: runs `entry` (its `[[workers]]` entry; a
    /// separate component's is the worker's id) as worker `worker`, with
    /// JSON `args`: what it returns is its result (JSON).
    run: func(entry: string, worker: u64, args: string) -> result<string, string>;
    /// An owner: its worker `worker` posted `message`, in order.
    on-message: func(worker: u64, message: string);
    /// An owner: its worker's progress (they coalesce: at most one a
    /// frame).
    on-progress: func(worker: u64, progress: progress-report);
    /// An owner: its worker ended; its last.
    on-done: func(worker: u64, outcome: outcome);
}

world extension {
    import host;
    import worker;
    export guest;
    export work;
}
